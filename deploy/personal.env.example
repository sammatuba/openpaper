# Copy to deploy/personal.env (git-ignored) and fill in. deploy.sh sources it.

# GCP
GCLOUD_CONFIGURATION=personal          # `gcloud config configurations create personal`
PROJECT_ID=openpaper-personal          # must be globally unique; add a suffix
BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX   # `gcloud billing accounts list`
REGION=asia-southeast1                 # pair with Neon aws-ap-southeast-1
TAG=latest

# Who may sign in (comma-separated, case-insensitive)
ALLOWED_EMAILS=jansammat26@gmail.com

# Cloudflare R2
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=openpaper-papers
# Host written into stored file URLs. Keep the private endpoint host unless
# PDFs fail to open, then enable the bucket's public dev URL and put its host here.
R2_PUBLIC_HOST=${R2_ACCOUNT_ID}.r2.cloudflarestorage.com/${R2_BUCKET}

# Secrets (pushed to Secret Manager by `deploy.sh secrets`; never committed)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
JOBS_INTERNAL_SECRET=          # `openssl rand -hex 32`
ADMIN_SECRET_KEY=              # `openssl rand -hex 32`
