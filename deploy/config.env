# Non-secret deploy settings, committed. Secrets never live in a file: they are
# entered once with `deploy/deploy.sh secrets-init` (prompted, written straight
# to Secret Manager) and pulled by Cloud Run, the jobs and the scheduler at
# deploy time. See deploy/README.md.

GCLOUD_CONFIGURATION=personal          # `gcloud config configurations create personal`
PROJECT_ID=openpaper-sammatuba         # globally unique; change if taken
BILLING_ACCOUNT=                       # optional here; `deploy.sh bootstrap` prompts if unset
REGION=asia-southeast1                 # paired with Neon aws-ap-southeast-1
TAG=latest

# Who may sign in (comma-separated, case-insensitive)
ALLOWED_EMAILS=jansammat26@gmail.com

# Cloudflare R2 (account id is not a secret; it is part of every R2 URL)
R2_ACCOUNT_ID=
R2_BUCKET=openpaper-papers
# Host written into stored object URLs; the app presigns by key so the bucket stays private.
R2_PUBLIC_HOST=
